rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This app has no authentication yet, so these rules can't tell users
    // apart — they only validate shape/size to reduce abuse. Add Firebase
    // Auth and scope reads/writes to request.auth.uid if you need recipes
    // to be private per user.
    match /recipes/{recipeId} {
      allow read: if true;

      allow create: if request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.servings is int
        && request.resource.data.servings > 0
        && request.resource.data.servings <= 100
        && request.resource.data.prepMinutes is int
        && request.resource.data.prepMinutes > 0
        && request.resource.data.prepMinutes <= 1440
        && request.resource.data.ingredients is list
        && request.resource.data.ingredients.size() <= 50
        && request.resource.data.steps is list
        && request.resource.data.steps.size() <= 50
        && request.resource.data.isCustom == true;

      allow update: if request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.ingredients is list
        && request.resource.data.ingredients.size() <= 50
        && request.resource.data.steps is list
        && request.resource.data.steps.size() <= 50;

      allow delete: if true;
    }
  }
}
